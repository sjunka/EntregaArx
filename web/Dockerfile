FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_OIDC_AUTHORITY=http://localhost:8081/realms/carpeta
ARG VITE_MCS_AFILIACION=http://localhost:8082
ARG VITE_MCS_CUSTODIA=http://localhost:8083
ARG VITE_MCS_NOTIFICACIONES=http://localhost:8087
ARG VITE_MCS_INDICE=http://localhost:8091
ARG VITE_MCS_AUDITORIA=http://localhost:8092
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY VITE_MCS_AFILIACION=$VITE_MCS_AFILIACION VITE_MCS_CUSTODIA=$VITE_MCS_CUSTODIA VITE_MCS_NOTIFICACIONES=$VITE_MCS_NOTIFICACIONES VITE_MCS_INDICE=$VITE_MCS_INDICE VITE_MCS_AUDITORIA=$VITE_MCS_AUDITORIA
RUN npm run build

FROM nginx:1.29-alpine
COPY --from=build /app/dist /usr/share/nginx/html
