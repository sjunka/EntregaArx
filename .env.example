# Copiar a .env (no se versiona). Valores solo para desarrollo local.
PG_CLAVE=cambia-esta-clave
# Secreto del cliente afiliacion-admin (Admin API del emisor o de Keycloak).
KC_AFILIACION_SECRETO=cambia-este-secreto
# Contraseña de la cuenta de demostración andres.perez.45678@carpetacolombia.co.
USUARIO_DEMO_CLAVE=cambia-esta-clave
# Para usar el GovCarpeta real: GOVCARPETA_URL=https://govcarpeta-apis-4905ff3c005b.herokuapp.com
# Escribir en él exige además GOVCARPETA_ESCRITURA=1 y permiso explícito.
# OPERADOR_ID=
# Credenciales de MinIO (almacén S3 local); en la nube serán llaves HMAC de GCS.
S3_ACCESS_KEY=mcs-minio
S3_SECRET_KEY=cambia-esta-clave-larga
# Secreto del cliente de servicio `interoperabilidad` (client credentials hacia la custodia).
KC_INTEROP_SECRETO=cambia-este-secreto-tambien
# Secreto del cliente de servicio `custodia` (client credentials hacia autorizaciones, RI-08).
KC_CUSTODIA_SECRETO=cambia-este-secreto-de-custodia
# Firma los enlaces del correo de un envío a una entidad no afiliada (HU-08). Cualquier cadena larga y aleatoria.
ENLACE_SECRETO=cambia-este-secreto-de-enlaces-largo
# Firma el enlace de activación que recibe el ciudadano trasladado (HU-09). Cualquier cadena larga y aleatoria.
ACTIVACION_SECRETO=cambia-este-secreto-de-activacion-largo
