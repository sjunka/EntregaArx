#cloud-config
# Container-Optimized OS: dos contenedores con las mismas imágenes que compose.yaml. Los datos viven en el disco de arranque.
write_files:
  - path: /etc/systemd/system/kafka.service
    content: |
      [Service]
      ExecStartPre=-/usr/bin/docker rm -f kafka
      ExecStart=/usr/bin/docker run --name kafka --rm --network host -v /var/kafka:/var/lib/kafka/data \
        -e KAFKA_NODE_ID=1 -e KAFKA_PROCESS_ROLES=broker,controller \
        -e KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093 \
        -e KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${ip}:9092 \
        -e KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
        -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT \
        -e KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093 \
        -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 -e KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 \
        -e KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 -e KAFKA_HEAP_OPTS="-Xmx512m -Xms512m" \
        apache/kafka:3.9.0
      Restart=always
  - path: /etc/systemd/system/schema-registry.service
    content: |
      [Service]
      ExecStartPre=-/usr/bin/docker rm -f schema-registry
      ExecStart=/usr/bin/docker run --name schema-registry --rm --network host \
        -e SCHEMA_REGISTRY_HOST_NAME=${ip} -e SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=${ip}:9092 \
        -e SCHEMA_REGISTRY_LISTENERS=http://0.0.0.0:8081 -e SCHEMA_REGISTRY_HEAP_OPTS="-Xmx256m -Xms256m" \
        confluentinc/cp-schema-registry:7.7.1
      Restart=always
runcmd:
  - mkdir -p /var/kafka && chown 1000:1000 /var/kafka
  - systemctl daemon-reload
  - systemctl start kafka.service schema-registry.service
